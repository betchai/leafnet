# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mulberry_leaf_intelligence?schema=public

# Node.js API server port
API_PORT=4000

# URL of the Python ML inference service (to be implemented in a later phase)
ML_SERVICE_URL=http://localhost:8000

# Path where trained model artifacts are stored (relative to ml/)
MODEL_PATH=ml/models/current

# Where uploaded images are stored
UPLOAD_DIRECTORY=./uploads
